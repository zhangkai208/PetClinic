{
  "name": "petclinic-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "张恺",
  "description": "宠物健康管理与服务预约系统",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.2",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.7",
    "pinia": "^2.2.6",
    "pinia-persistedstate-plugin": "^0.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sass": "^1.77.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3"
  },
  "build": {
    "appId": "com.zk.petclinic",
    "productName": "宠物健康管理系统",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}